generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id                  Int           @id @default(autoincrement())
  make                String        @db.VarChar(50)
  model               String        @db.VarChar(50)
  year                Int
  services            String
  extras              String?
  date                DateTime      @db.Date
  time                String        @db.VarChar(20)
  status              BookingStatus @default(PENDING)
  address             String        @db.VarChar(255)
  city                String        @db.VarChar(100)
  email               String        @db.VarChar(255)
  notes               String?
  arrivedAt           DateTime?
  completedAt         DateTime?
  confirmationCode    String        @db.VarChar(10)
  createdAt           DateTime      @default(now())
  detailerId          Int?
  emailSent           Boolean       @default(false)
  enRouteAt           DateTime?
  estimatedDuration   Int?
  firstName           String        @db.VarChar(100)
  lastName            String        @db.VarChar(100)
  phoneNumber         String        @db.VarChar(20)
  postalCode          String        @db.VarChar(10)
  reminderSent        Boolean       @default(false)
  specialInstructions String?
  startedAt           DateTime?
  totalPrice          Decimal?      @db.Decimal(8, 2)
  updatedAt           DateTime      @updatedAt
  vehicleType         String        @db.VarChar(50)

  @@map("bookings")
}

model Detailer {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  phone          String   @unique @db.VarChar(20)
  email          String   @unique @db.VarChar(255)
  createdAt      DateTime @default(now())
  isActive       Boolean  @default(true)
  supabaseUserId String?  @db.VarChar(255)
  updatedAt      DateTime @updatedAt

  @@map("detailers")
}

model Contact {
  id        Int           @id @default(autoincrement())
  name      String        @db.VarChar(100)
  email     String        @db.VarChar(255)
  phone     String?       @db.VarChar(20)
  subject   String        @db.VarChar(200)
  message   String
  status    ContactStatus @default(NEW)
  createdAt DateTime      @default(now())
  emailSent Boolean       @default(false)
  updatedAt DateTime      @updatedAt

  @@map("contacts")
}

model Service {
  id          Int             @id @default(autoincrement())
  name        String          @db.VarChar(100)
  description String?
  category    ServiceCategory @default(DETAILING)
  createdAt   DateTime        @default(now())
  isActive    Boolean         @default(true)
  sortOrder   Int             @default(0)
  updatedAt   DateTime        @updatedAt

  @@map("services")
}

model ServicePricing {
  id          Int      @id @default(autoincrement())
  price       Decimal  @db.Decimal(8, 2)
  createdAt   DateTime @default(now())
  serviceId   Int
  updatedAt   DateTime @updatedAt
  vehicleType String   @db.VarChar(50)

  @@map("service_pricing")
}

model AddOn {
  id          Int           @id @default(autoincrement())
  name        String        @unique @db.VarChar(100)
  description String?
  category    AddOnCategory @default(ENHANCEMENT)
  price       Decimal       @db.Decimal(8, 2)
  createdAt   DateTime      @default(now())
  isActive    Boolean       @default(true)
  sortOrder   Int           @default(0)
  updatedAt   DateTime      @updatedAt

  @@map("add_ons")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  EN_ROUTE
  STARTED
  IN_PROGRESS
  COMPLETED
  CANCELED
  NO_SHOW
}

enum ContactStatus {
  NEW
  IN_PROGRESS
  RESOLVED
  ARCHIVED
}

enum ServiceCategory {
  DETAILING
  PROTECTION
  RESTORATION
  MAINTENANCE
  SPECIALTY
}

enum AddOnCategory {
  ENHANCEMENT
  PROTECTION
  CLEANING
  RESTORATION
}

enum admin_role {
  super_admin
  admin
  manager
  staff
}

enum booking_status {
  pending
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum notification_channel {
  email
  sms
  push
}

enum payment_status {
  unpaid
  deposit_paid
  paid
  refunded
  partially_refunded
}
