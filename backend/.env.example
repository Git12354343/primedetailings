# Database Configuration
DATABASE_URL="mysql://root:password@localhost:3306/primedetailing"

# Redis Configuration (Optional - falls back to in-memory if not configured)
# For production, use Redis for scalability
REDIS_URL="redis://localhost:6379"
# Or for Redis Cloud: redis://username:password@host:port

# Twilio Configuration (Required for SMS)
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# Email Configuration (Optional)
EMAIL_HOST="smtp.gmail.com"
EMAIL_PORT=587
EMAIL_USER="your-email@gmail.com"
EMAIL_PASS="your-app-password"
EMAIL_FROM="Prime Detailing <noreply@primedetailing.com>"

# Optional: Business phone for contact form notifications
BUSINESS_PHONE="+15141234567"

# Server Configuration
PORT=3001
NODE_ENV=development

# Frontend Configuration
FRONTEND_URL="http://localhost:5173"

# Security
JWT_SECRET="b73V1pXkFz92rQa4LwEYosUhgDCM7Z"
BCRYPT_ROUNDS=12

# Pricing Configuration
ENABLE_DYNAMIC_PRICING=true
ENABLE_WEEKEND_SURCHARGE=true
ENABLE_WINTER_SURCHARGE=true