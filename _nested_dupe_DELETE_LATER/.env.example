# ─── Supabase ────────────────────────────────────────────────────────────────
# Supabase project URL (Settings → API)
SUPABASE_URL="https://your-project-id.supabase.co"

# Supabase anon/public key (safe to expose to clients)
SUPABASE_ANON_KEY="your-anon-key"

# Supabase service_role key (NEVER expose — backend only)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Prisma: Supabase Pooler URL (Transaction mode, port 6543) — for Prisma runtime
DATABASE_URL="postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Prisma: Supabase direct connection (port 5432) — for migrations only
DIRECT_URL="postgresql://postgres.your-project-id:your-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres"

# ─── Twilio ───────────────────────────────────────────────────────────────────
TWILIO_ACCOUNT_SID="your_twilio_account_sid_here"
TWILIO_AUTH_TOKEN="your_twilio_auth_token_here"
TWILIO_PHONE_NUMBER="+1234567890"

# ─── Email ────────────────────────────────────────────────────────────────────
EMAIL_USER="your-gmail@gmail.com"
EMAIL_APP_PASSWORD="your-app-password"

# ─── App ─────────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
FRONTEND_URL="http://localhost:5173"
JWT_SECRET="replace-with-secure-random-string"

# ─── Business ─────────────────────────────────────────────────────────────────
BUSINESS_NAME="Prestige Plus Services"
BUSINESS_PHONE="+14387968001"
# Booking cancellation cutoff (hours before appointment)
CANCEL_CUTOFF_HOURS=24

# Admin API secret — used by admin routes for write operations
# Set a strong random string: openssl rand -hex 32
ADMIN_SECRET=your-strong-admin-secret-here

# Frontend URL for CORS (set to your production domain in prod)
FRONTEND_URL=http://localhost:5173
